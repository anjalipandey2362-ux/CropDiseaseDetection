# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Environments
venv/
env/
ENV/

# Large Datasets
dataset/raw/*
!dataset/raw/.gitkeep
dataset/processed/*
!dataset/processed/.gitkeep
dataset/crop/*
!dataset/crop/.gitkeep
dataset/diseases/*
!dataset/diseases/.gitkeep

# Evaluation Results
evaluation/results/*
!evaluation/results/.gitkeep

# Saved Models & Weights (keep folder structure, exclude .pth binary files)
*.pth
*.pt
*.onnx
*.h5

# Environment variables & secrets
.env
.env.local
